@import "../../../style/skin.wxss";

.list {
	width: 100%;
	display: flex;
	flex-direction: column;
}

.list .item {
	width: 100%;
	display: flex;
	background-color: #fff;
	padding: 20rpx 20rpx;
	font-size: 30rpx;
	border-radius: 10rpx;
	margin-right: 20rpx;
	border-bottom: 20rpx;
	margin-bottom: 20rpx;
}

.list .item .left {
	display: flex;
	margin-right: 20rpx;
}

.list .item .left image {
	width: 200rpx;
	height: 160rpx;
	border-radius: 20rpx;
	overflow: hidden;
}

.list .item .right {
	flex: 1;
	display: flex;
	flex-direction: column;
}

.list .item .right .title {
	font-size: 30rpx;
	color: #333;
}

.list .item .right .desc {
	font-size: 24rpx;
	color: #777;
	margin-top: 10rpx;
}
